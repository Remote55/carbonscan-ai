{
  "name": "carbonscan-ai",
  "version": "0.1.0",
  "private": true,
  "description": "NSC 2026 — Tree Biomass Carbon Assessment Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "web:dev": "pnpm --filter web dev",
    "mobile:run": "cd apps/mobile && flutter run",
    "api:dev": "cd services/api && uvicorn app.main:app --reload",
    "ml:notebook": "cd services/ml && jupyter lab"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
