# =============================================================================
# TreeQ Carbon Platform - Backend API Environment Variables
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Every variable here is read by app/core/config.py. That was not true before:
# this file advertised a JWT block for an auth system nothing imported, RunPod
# credentials for a GPU path that was never built, a PGMQ queue that did not
# exist, two rate-limit tiers nothing enforced, and image extensions for a photo
# path that has been dropped. A sample config is the first thing a new developer
# copies, so listing settings the code does not read sends them looking for
# behaviour that is not there.

# --- App ---
APP_ENV=development                    # development | staging | production
APP_NAME="TreeQ Carbon Platform API"
# Leave false in production. It gates /docs, /redoc and /openapi.json, and the
# default is true, so an unset value publishes the whole API surface.
APP_DEBUG=true

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,https://treeqcarbon.vercel.app

# --- Ephemeral Judge Demo ---
TREEQ_DEMO_MODE=false
TREEQ_DEMO_TOKEN=                      # 64 lowercase hex characters; never commit a real token
TREEQ_DEMO_MAX_UPLOAD_SIZE_MB=100      # the effective cap in EVERY mode, not just demo
TREEQ_DEMO_MAX_POINTS=2000000          # checked from the PLY header before any work starts
TREEQ_DEMO_ALLOWED_ORIGINS=https://treeqcarbon.vercel.app,http://127.0.0.1:3000,http://localhost:3000

# --- Database (PostgreSQL + PostGIS) ---
# Local Docker:  postgresql+asyncpg://postgres:postgres@localhost:5432/carbonscan
# Supabase:      postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/carbonscan
DATABASE_ECHO=false

# --- Supabase ---
# Authentication is Supabase's. The API verifies a Bearer token against
# GET /auth/v1/user; it issues no tokens of its own.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- ML pipeline ---
# Both empty = auto-detect from the monorepo layout (services/ml and its .venv).
# In the Docker image ML_DIR is set to /app/services/ml and there is one
# interpreter, so the pipeline runs under the same Python as the API.
ML_DIR=
ML_PYTHON=

# --- File Upload ---
# The effective cap is the SMALLER of this and TREEQ_DEMO_MAX_UPLOAD_SIZE_MB.
# The accepted extensions are not configurable: they are whatever the pipeline
# can load, listed in app/services/upload_validation.ANALYZE_EXTENSIONS.
MAX_UPLOAD_SIZE_MB=500

# --- Logging ---
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                        # json for a hosted log viewer, console for a terminal

# --- Load shedding ---
# How often ONE caller may ask.
RATE_LIMIT_UPLOAD=5                    # uploads per client per minute, in every mode
# How much work may be in flight at once, across all callers. Each slot holds an
# upload in memory plus a pipeline subprocess, so raise it only with the host's
# RAM in hand. Callers arriving when every slot is busy get 503 + Retry-After.
MAX_CONCURRENT_ANALYSES=2
# Set true behind Railway / Fly / HF Spaces / Cloudflare, where the socket peer
# is the proxy and every caller would otherwise share one rate-limit bucket.
# Leave false when nothing sits in front: the header is caller-controlled, and
# trusting it then lets anyone mint a fresh identity per request.
TRUST_PROXY_HEADERS=false
