# =============================================================================
# CarbonScan AI - Backend API Environment Variables
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- App ---
APP_ENV=development                    # development | staging | production
APP_NAME="CarbonScan AI API"
APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=http://localhost:8000

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,https://carbonscan-ai.vercel.app

# --- Ephemeral Judge Demo ---
TREEQ_DEMO_MODE=false
TREEQ_DEMO_TOKEN=                     # 64 lowercase hex characters; never commit a real token
TREEQ_DEMO_MAX_UPLOAD_SIZE_MB=100
TREEQ_DEMO_MAX_POINTS=2000000
TREEQ_DEMO_ALLOWED_ORIGINS=https://treeqcarbon.vercel.app,http://127.0.0.1:3000,http://localhost:3000

# --- Database (PostgreSQL + PostGIS) ---
# Local Docker:  postgresql+asyncpg://postgres:postgres@localhost:5432/carbonscan
# Supabase:      postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/carbonscan
DATABASE_ECHO=false

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET_POINTCLOUDS=point-clouds
SUPABASE_STORAGE_BUCKET_PHOTOS=photos
SUPABASE_STORAGE_BUCKET_REPORTS=reports

# --- JWT Auth ---
JWT_SECRET=change-me-to-a-random-32-byte-string-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- GPU Worker (RunPod) ---
RUNPOD_API_KEY=                        # from https://www.runpod.io/console/user/settings
RUNPOD_ENDPOINT_ID=                    # serverless endpoint id

# --- Queue ---
# Job queue uses Supabase PGMQ (Postgres-native via DATABASE_URL) — no Redis needed.

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=500
ALLOWED_LAS_EXTENSIONS=.las,.laz,.ply
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png

# --- Logging ---
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                        # json | console

# --- Rate Limiting ---
RATE_LIMIT_AUTHENTICATED=60            # requests per minute
RATE_LIMIT_PUBLIC=20
RATE_LIMIT_UPLOAD=5                    # uploads per client per minute in demo mode
