# =============================================================================
# CarbonScan AI - ML Pipeline Environment Variables
# =============================================================================

# --- Hugging Face Hub (for model hosting) ---
HF_TOKEN=

# --- Weights & Biases (optional experiment tracking) ---
WANDB_API_KEY=
WANDB_PROJECT=carbonscan-ai
WANDB_ENTITY=

# --- NEON Data Portal (LiDAR dataset download) ---
NEON_API_TOKEN=

# --- Supabase (for downloading uploaded files) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- RunPod ---
RUNPOD_API_KEY=

# --- Pipeline config ---
PIPELINE_LOG_LEVEL=INFO
PIPELINE_DEVICE=auto                   # auto | cpu | cuda | mps
PIPELINE_BATCH_SIZE=4
PIPELINE_MAX_POINTS_PER_TREE=8192
PIPELINE_OUTPUT_DIR=./output

# --- Model paths ---
MODEL_WOOD_LEAF_PATH=./models/pointnet_wood_leaf_v1.pth
MODEL_SPECIES_PATH=./models/resnet_species_v1.pth
SPECIES_DB_PATH=./data/species_db.csv
