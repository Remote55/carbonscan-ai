# syntax=docker/dockerfile:1.7
# CPU image — for local dev, testing, or low-cost inference

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY pyproject.toml ./
RUN pip install --upgrade pip && pip install -e ".[cpu]"

COPY pipeline/ ./pipeline/
COPY photogrammetry/ ./photogrammetry/
COPY data/species_db.csv ./data/

CMD ["python", "-m", "pipeline.main", "--help"]
