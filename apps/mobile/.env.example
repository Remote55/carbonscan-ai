# =============================================================================
# CarbonScan AI — Mobile App Environment
# =============================================================================
# Flutter doesn't read .env files natively. These values are passed via
# --dart-define at build/run time:
#
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000 \
#               --dart-define=SUPABASE_URL=https://xxx.supabase.co \
#               --dart-define=SUPABASE_ANON_KEY=eyJ...
#
# Or wrap in a shell script: see scripts/run-dev.sh

# --- Backend API ---
# Android emulator: 10.0.2.2 = host machine's localhost
# Physical device on same WiFi: use your laptop's LAN IP (e.g., 192.168.1.50)
# Production: https://api.carbonscan-ai.com
API_BASE_URL=http://10.0.2.2:8000

# --- Supabase (from supabase.com dashboard) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Feature flags ---
ENABLE_SPECIES_CLASSIFIER=true
ENABLE_OFFLINE_MODE=false
